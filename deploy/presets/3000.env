# Preset: 3,000 Students (~300 - 450 Peak Concurrent)
# Target VPS: Hetzner CPX31 (4 vCPU AMD, 8 GB RAM, 160 GB NVMe) ~€11.50/mo
STUDENT_CAPACITY=3000

# Container Memory Limits
API_MEMORY_LIMIT=2048M
WORKER_MEMORY_LIMIT=1024M
PG_MEMORY_LIMIT=2560M
REDIS_MEMORY_LIMIT=1280M

# Redis Sizing
REDIS_MAXMEMORY=1024mb

# PostgreSQL Tuning
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=2GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_EFFECTIVE_CACHE_SIZE=6GB

# Prisma Client Pool
DATABASE_CONNECTION_LIMIT=25
DATABASE_POOL_TIMEOUT=20000

# Node Runtime
UV_THREADPOOL_SIZE=16
