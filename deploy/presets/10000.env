# Preset: 10,000 Students (~1,400 - 2,000 Peak Concurrent)
# Target VPS: Hetzner CCX43 Dedicated vCPU (16 Dedicated vCPU, 64 GB RAM, 360 GB NVMe) ~€110.00/mo
STUDENT_CAPACITY=10000

# Container Memory Limits
API_MEMORY_LIMIT=8192M
WORKER_MEMORY_LIMIT=4096M
PG_MEMORY_LIMIT=20480M
REDIS_MEMORY_LIMIT=5120M

# Redis Sizing
REDIS_MAXMEMORY=4096mb

# PostgreSQL Tuning
PG_MAX_CONNECTIONS=250
PG_SHARED_BUFFERS=16GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=2048MB
PG_EFFECTIVE_CACHE_SIZE=48GB

# Prisma Client Pool
DATABASE_CONNECTION_LIMIT=60
DATABASE_POOL_TIMEOUT=20000

# Node Runtime
UV_THREADPOOL_SIZE=32
