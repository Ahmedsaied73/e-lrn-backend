# Preset: 4,000 Students (~450 - 650 Peak Concurrent)
# Target VPS: Hetzner CPX31 (4 vCPU AMD, 8 GB RAM, 160 GB NVMe) ~€11.50/mo
STUDENT_CAPACITY=4000

# Container Memory Limits
API_MEMORY_LIMIT=2560M
WORKER_MEMORY_LIMIT=1280M
PG_MEMORY_LIMIT=2816M
REDIS_MEMORY_LIMIT=1536M

# Redis Sizing
REDIS_MAXMEMORY=1280mb

# PostgreSQL Tuning
PG_MAX_CONNECTIONS=120
PG_SHARED_BUFFERS=2GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_EFFECTIVE_CACHE_SIZE=6GB

# Prisma Client Pool
DATABASE_CONNECTION_LIMIT=30
DATABASE_POOL_TIMEOUT=20000

# Node Runtime
UV_THREADPOOL_SIZE=16
