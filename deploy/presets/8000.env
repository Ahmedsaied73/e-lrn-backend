# Preset: 8,000 Students (~1,000 - 1,400 Peak Concurrent)
# Target VPS: Hetzner CCX33 Dedicated vCPU (8 Dedicated vCPU, 32 GB RAM, 240 GB NVMe) ~€55.00/mo
STUDENT_CAPACITY=8000

# Container Memory Limits
API_MEMORY_LIMIT=5120M
WORKER_MEMORY_LIMIT=2560M
PG_MEMORY_LIMIT=10240M
REDIS_MEMORY_LIMIT=3584M

# Redis Sizing
REDIS_MAXMEMORY=3072mb

# PostgreSQL Tuning
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=8GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=1024MB
PG_EFFECTIVE_CACHE_SIZE=24GB

# Prisma Client Pool
DATABASE_CONNECTION_LIMIT=50
DATABASE_POOL_TIMEOUT=20000

# Node Runtime
UV_THREADPOOL_SIZE=32
