# Preset: 6,000 Students (~700 - 1,000 Peak Concurrent)
# Target VPS: Hetzner CPX41 (8 vCPU AMD, 16 GB RAM, 240 GB NVMe) ~€22.70/mo
STUDENT_CAPACITY=6000

# Container Memory Limits
API_MEMORY_LIMIT=3584M
WORKER_MEMORY_LIMIT=2048M
PG_MEMORY_LIMIT=5120M
REDIS_MEMORY_LIMIT=2560M

# Redis Sizing
REDIS_MAXMEMORY=2048mb

# PostgreSQL Tuning
PG_MAX_CONNECTIONS=150
PG_SHARED_BUFFERS=4GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_EFFECTIVE_CACHE_SIZE=12GB

# Prisma Client Pool
DATABASE_CONNECTION_LIMIT=40
DATABASE_POOL_TIMEOUT=20000

# Node Runtime
UV_THREADPOOL_SIZE=32
