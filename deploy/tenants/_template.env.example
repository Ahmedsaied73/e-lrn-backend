# ==============================================================================
# TENANT CONFIGURATION TEMPLATE — أكاديمية التميز
# ==============================================================================
# Instructions:
# 1. Copy this file to `/opt/teacher-app/.env` on the teacher's VPS.
# 2. Fill in the real credentials for this specific teacher tenant.
# 3. Secure file permissions immediately: chmod 600 /opt/teacher-app/.env
#    chown deploy:deploy /opt/teacher-app/.env
# 4. NEVER commit or push populated .env files to GitHub.
# ==============================================================================

# ── General Server & Domain ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3005
TENANT_NAME=teacher-slug-name
DOMAIN_NAME=api.teacherdomain.com
# Specific frontend origin(s). Wildcards (* or *.domain) are strictly rejected in production.
FRONTEND_URL=https://teacherdomain.com

# ── PostgreSQL Internal Database ─────────────────────────────────────────────
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PG_PASSWORD_32_CHARS
POSTGRES_DB=elearning_db

# ── Redis Cache & Queues ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD_32_CHARS
REDIS_ENABLED=true
REQUIRE_REDIS_RATE_LIMIT=false

# ── JWT Authentication & Session Secrets ─────────────────────────────────────
# Generate via: openssl rand -hex 32
JWTSECRET=CHANGE_ME_RANDOM_HEX_64_CHARACTERS
REFRESH_TOKEN_SECRET=CHANGE_ME_DIFFERENT_RANDOM_HEX_64_CHARACTERS
# Same-site cookie layout: FE=https://teacherdomain.com, API=https://api.teacherdomain.com
COOKIE_DOMAIN=.teacherdomain.com
COOKIE_SAMESITE=lax

# ── Default Teacher Admin Account ────────────────────────────────────────────
# Seeded automatically on initial boot
ADMIN_EMAIL=teacher@teacherdomain.com
ADMIN_PASSWORD=CHANGE_ME_INITIAL_STRONG_ADMIN_PASSWORD
ADMIN_NAME="الأستاذ / اسم المعلم"
ADMIN_PHONE="01000000000"

# ── Bunny.net Stream Video Hosting ───────────────────────────────────────────
BUNNY_STREAM_API_KEY=your-bunny-stream-api-key
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_READ_ONLY_API_KEY=your-bunny-read-only-api-key
BUNNY_STREAM_TOKEN_KEY=your-bunny-signed-token-auth-key
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxx.b-cdn.net

# ── Storage (Quiz & Course Thumbnails) ────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_QUIZ_BUCKET=quiz-images

# ── AI Essay Grading, Photo Extraction & Admin Agent (Google Gemini) ─────────
GEMINI_API_KEY=your-gemini-api-key
AI_GRADER_ENABLED=true
AI_GRADER_MODEL=gemini-3.6-flash
AI_GRADER_CONFIDENCE_THRESHOLD=0.8
AI_GRADER_TIMEOUT_MS=45000
AI_STUDENT_SUBJECT=MATH
ESSAY_PHOTO_ENABLED=true
AI_AGENT_ENABLED=true
AI_AGENT_ALLOW_MUTATIONS=true

# ── Payments (Paymob) ────────────────────────────────────────────────────────
PAYMENTS_ENABLED=true
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_INTEGRATION_ID=123456
PAYMOB_IFRAME_ID=123456
PAYMOB_HMAC_SECRET=your-paymob-hmac-secret

# ── Observability & Monitoring ───────────────────────────────────────────────
# Scraped by central Prometheus with: Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=CHANGE_ME_RANDOM_METRICS_BEARER_TOKEN
# Optional backend error tracking (leave blank to disable):
SENTRY_DSN=

# ── Backups & Disaster Recovery ──────────────────────────────────────────────
# Destination bucket configured in /root/.config/rclone/rclone.conf (e.g. Cloudflare R2)
BACKUP_STORAGE_DEST=r2:teacher-backups/teacher-slug-name
# Passphrase used to encrypt backups with GPG before uploading:
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_SECURE_PASSPHRASE_FOR_GPG
# Optional Healthchecks.io ping URL (pings /start, success, /fail; alerts if missed):
HEALTHCHECK_URL=
# Telegram Bot alerts for backup success/failure:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890
