# Database Configuration — Supabase Postgres (single DB for dev + prod).
# Pooled (6543, PgBouncer) for the app; direct (5432) for `prisma migrate`.
# Get both from Supabase Dashboard → Project Settings → Database → Connection string.
# sslmode=require is mandatory: Supabase poolers reject plaintext connections.
DATABASE_URL="postgresql://postgres:[DB-PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:[DB-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Environment & Frontend Configuration
NODE_ENV="development"
PORT="3005"
# Comma-separated allowed frontend origins (Vercel prod + PR previews). In
# production with FE on Vercel and this API on Railway, cookies are cross-site,
# so cookie config switches to SameSite=None; Secure (set COOKIE_SAMESITE to
# override). TRUST_PROXY=1 trusts Railway's single proxy hop for real client IPs.
FRONTEND_URL="http://localhost:3000"
# COOKIE_SAMESITE="none"      # default: none in prod, lax in dev
# TRUST_PROXY="1"             # default: 1 (Railway single-hop)

# JWT Configuration
JWTSECRET="your_jwt_secret_here"
# Access + refresh expiry defaults are '15m' and '7d' (createToken/createRefreshToken
# in src/utils.js). These env vars must stay in lock-step with the cookie maxAge in
# src/config/cookie.js — access JWT 15m == access cookie maxAge 15m (T5.2).
JWT_EXPIRY="15m"
# IMPORTANT: REFRESH_TOKEN_SECRET must be a random string, different from
# JWTSECRET. Refresh tokens are signed with it (rotation-friendly). The app
# refuses to start in production if this still looks like a placeholder.
REFRESH_TOKEN_SECRET="your_refresh_token_secret"
REFRESH_TOKEN_EXPIRY="7d"

# Admin Configuration
ADMIN_EMAIL="admin@elearning.com"
ADMIN_PASSWORD="admin123"

# Email (DORMANT — parsed into config.email but nothing sends mail today;
# nodemailer is unpackaged until a real mail flow is ordered).
# EMAIL_SERVICE="gmail"
# EMAIL_USER="you@example.com"
# EMAIL_PASS="app-password"

# ── Bunny.net Stream Configuration ──────────────────────────────────────────
# Required for video upload, webhook, and signed playback features.
# Get these from your Bunny dashboard → Stream Library → API / Security tabs.
#
# BUNNY_STREAM_LIBRARY_ID  — Numeric library ID (visible in the dashboard URL)
# BUNNY_STREAM_API_KEY     — Full-access API key (creates/uploads/deletes videos)
# BUNNY_STREAM_READ_ONLY_API_KEY — Read-only key; ALSO used as the webhook signing secret
# BUNNY_STREAM_TOKEN_KEY   — Token Authentication Key (from library Security tab)
# BUNNY_VIDEO_MAX_BYTES    — Max allowed upload size in bytes (default: 5GB)
#
# IMPORTANT: Enable "Embed View Token Authentication" in the Bunny library
# Security settings, otherwise signed URLs are not enforced and any viewer
# can watch any video by guessing the video ID.
BUNNY_STREAM_LIBRARY_ID="your_library_id_here"
BUNNY_STREAM_API_KEY="your_bunny_api_key_here"
BUNNY_STREAM_READ_ONLY_API_KEY="your_bunny_read_only_api_key_here"
BUNNY_STREAM_TOKEN_KEY="your_bunny_token_key_here"
BUNNY_STREAM_TOKEN_TTL_SECONDS=21600
BUNNY_VIDEO_MAX_BYTES=5368709120

# Supabase (Postgres + Storage for quiz question images).
# Project Settings → API for URL + service_role key; Storage → `quiz-images` bucket (public).
# The service key NEVER leaves the server — uploads are proxied via POST /quizzes/images.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key"
SUPABASE_QUIZ_BUCKET="quiz-images"

# Redis (Upstash) — cache + rate-limit store + future BullMQ.
# TCP endpoint (rediss://) is required; the HTTPS REST endpoint does NOT work
# with ioredis/BullMQ. REDIS_ENABLED=false (or no URL) = pure passthrough.
# REQUIRE_REDIS_RATE_LIMIT=false (default) fails OPEN with a per-instance
# in-memory fallback when the Redis store is down (limiting still holds per
# process — but is NOT shared across instances); set true to fail CLOSED
# (503 RATE_LIMIT_STORE_UNAVAILABLE). Fatal in production if true + Redis unset.
REDIS_URL="rediss://default:[TOKEN]@[ENDPOINT].upstash.io:6379"
REDIS_ENABLED="true"
# REQUIRE_REDIS_RATE_LIMIT="true"

# Account lockout on repeated login failures (Redis-backed, fail-open when
# Redis is off — the per-IP login limiter always applies). Consecutive failed
# logins for a single email beyond LOGIN_FAILURE_THRESHOLD lock that account
# for ACCOUNT_LOCKOUT_MS (login returns 423 ACCOUNT_LOCKED with Retry-After).
LOGIN_FAILURE_THRESHOLD=5
ACCOUNT_LOCKOUT_MS=900000

# AI Grader (essay grading) — Google Gemini via LangChain + BullMQ on Redis.
# Missing key = AI grading silently off (essays wait in the human inbox).
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key"
AI_GRADER_MODEL="gemini-3.6-flash"
AI_GRADER_CONFIDENCE_THRESHOLD="0.8"
AI_GRADER_TIMEOUT_MS="45000"
AI_GRADER_DAILY_BUDGET="1000"

# Optional feature modules (building blocks). Absence = default true.
# Restart after changing. Disabled modules are unmounted + skipped, never stubbed.
NOTIFICATIONS_ENABLED="true"
AI_GRADER_ENABLED="true"

# ── Paymob payments (course purchases) ─────────────────────────────────────
# DEFAULT OFF (false) = today's behavior: enrollments auto-marked as paid.
# Set true to require a verified Paymob payment before course access:
#   POST /enroll on a priced course returns 402 PAYMENT_REQUIRED and enrollment
#   is created only by the HMAC-verified Paymob callback. Admin enroll and
#   price=0 courses stay free. Restart after changing.
# Keys: Paymob dashboard → Settings → API Keys (Secret/Public/HMAC) and
# Settings → Payment Integrations (IDs). NEVER expose the Secret/HMAC client-side.
#
# PROD GO-LIVE ORDER (details: plans/prod-config-checklist.md section 5b):
#   1. Apply the payments migrations on prod DB (npx prisma migrate deploy).
#   2. Set the four real PAYMOB_* values (live-mode keys, never the test set).
#   3. Set PUBLIC_API_URL + FRONTEND_URL to the deployed hosts (below).
#   4. Run ONE real sandbox purchase with a test card (T9), verify the webhook
#      fulfilled the enrollment, THEN flip PAYMENTS_ENABLED=true and restart.
PAYMENTS_ENABLED="false"
PAYMOB_SECRET_KEY="your_paymob_secret_key"
PAYMOB_PUBLIC_KEY="your_paymob_public_key"
PAYMOB_HMAC_SECRET="your_paymob_hmac_secret"
# Comma-separated integration IDs (card, wallet). Test/Live must match the Secret Key.
PAYMOB_INTEGRATION_IDS="1234567"
# Regional base URL — Egypt default; Oman/UAE/KSA differ (oman./uae./ksa.paymob.com).
PAYMOB_BASE_URL="https://accept.paymob.com"
PAYMOB_CURRENCY="EGP"
# PAYMOB_INTENTION_EXPIRY_SECONDS=3600


# Payments URL plumbing (ONLY matters when PAYMENTS_ENABLED=true):
# PUBLIC_API_URL - this API public absolute base. The Paymob transaction
#   callback URL is built as PUBLIC_API_URL + /webhooks/paymob and sent with
#   the intention, so it MUST be the deployed reachable URL (dev default:
#   http://localhost:PORT).
# FRONTEND_URL - the FIRST comma-separated entry is where the browser lands
#   after paying: FRONTEND_URL + /payment/result (already declared above).
# PUBLIC_API_URL=https://api.example.com

# Optional backend error tracking (DSN-gated no-op when absent; FE stays on PostHog).
# Get a DSN: https://sentry.io ... or shift to your Sentry instance.
SENTRY_DSN=""

